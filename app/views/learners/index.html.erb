<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">My learners</h1>
  <%= link_to "Add a learner", new_learner_path, class: "btn btn-primary btn-sm" %>
</div>

<% if @learners.empty? %>
  <div class="text-center py-5">
    <p class="text-muted mb-3">You haven&rsquo;t added a learner yet.</p>
    <%= link_to "Add your first learner", new_learner_path, class: "btn btn-primary" %>
  </div>
<% else %>
  <div class="row g-3">
    <% @learners.each do |learner| %>
      <% plan = learner.latest_season_plan %>
      <div class="col-12">
        <%= link_to learner_path(learner), class: "text-decoration-none" do %>
          <div class="card card-hover">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <h2 class="h5 card-title mb-1 text-body"><%= learner.first_name %>, <%= learner.age %></h2>
                  <div><%= render "learners/area_badges", areas: learner.focus_areas %></div>
                </div>
                <div class="text-end small flex-shrink-0">
                  <% if plan&.completed? %>
                    <div class="text-body mb-1"><%= plan.summary %></div>
                    <div class="text-muted">proposed <%= time_ago_in_words(plan.generated_at) %> ago</div>
                  <% elsif plan&.failed? %>
                    <div class="text-muted fst-italic">last proposal could not be used</div>
                  <% else %>
                    <div class="text-muted fst-italic">no season proposed yet</div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
