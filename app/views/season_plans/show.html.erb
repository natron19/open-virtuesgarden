<% plan = @season_plan %>
<div data-controller="download-markdown"
     data-download-markdown-content-value="<%= plan.completed? ? plan.to_markdown : '' %>"
     data-download-markdown-filename-value="<%= plan.markdown_filename %>"
     style="max-width: 900px;">

  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
    <div>
      <p class="text-muted small mb-1">A season of aims</p>
      <h1 class="h3 mb-1"><%= @learner.first_name %>, <%= @learner.age %></h1>
      <p class="text-muted small mb-0">
        <%= link_to "← My learners", learners_path, class: "text-muted" %>
        &nbsp;&middot;&nbsp;
        <%= link_to "About #{@learner.first_name}", learner_path(@learner), class: "text-muted" %>
        &nbsp;&middot;&nbsp;
        Proposed <%= plan.generated_at ? "#{time_ago_in_words(plan.generated_at)} ago" : "at an unknown time" %>
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-start">
      <%= link_to "Edit learner", edit_learner_path(@learner), class: "btn btn-outline-secondary btn-sm" %>
      <%= render "learners/propose_button", learner: @learner, label: "Propose again",
                 button_class: "btn btn-outline-secondary btn-sm" %>
      <% if plan.completed? %>
        <button class="btn btn-outline-primary btn-sm" type="button"
                data-action="click->download-markdown#download">
          Download .md
        </button>
      <% end %>
      <button class="btn btn-outline-secondary btn-sm" type="button"
              data-bs-toggle="collapse" data-bs-target="#raw-response"
              aria-expanded="false" aria-controls="raw-response">
        Show raw response
      </button>
    </div>
  </div>

  <p class="text-muted small mb-3">
    <strong>AI-generated.</strong> A starting point for you to edit, not an assessment: it never tests, scores, ranks
    or diagnoses a child, it places no child anywhere, and it can be wrong. You decide what to keep.
  </p>

  <% if plan.stale? %>
    <div class="alert alert-warning py-2 small">
      You have edited <%= @learner.first_name %>&rsquo;s details since this season was proposed. Propose again to
      see a season for the new version.
    </div>
  <% end %>

  <% if plan.failed? %>
    <%= render "season_plans/parse_error", learner: @learner, plan: plan %>
  <% elsif plan.completed? %>
    <p class="mb-4">
      <span class="badge season-badge"><%= plan.aims.size %> aims</span>
      <span class="badge season-badge"><%= plan.matched_aims.size %> matched to an offering</span>
      <span class="badge season-badge gap-badge"><%= plan.gaps.size %> <%= plan.gaps.size == 1 ? "gap" : "gaps" %></span>
    </p>

    <% plan.aims_by_area.each do |area, aims| %>
      <h2 class="h5 mb-2 area-heading area-<%= area %>"><%= Learner.area_label(area) %></h2>
      <div class="row g-3 mb-4">
        <% aims.each do |aim| %>
          <div class="col-md-6">
            <div class="card h-100 aim-card">
              <div class="card-body">
                <h3 class="h6 mb-2"><%= aim["name"] %></h3>
                <p class="small mb-2"><%= aim["why"] %></p>
                <p class="small mb-2"><span class="text-muted">First step:</span> <%= aim["first_step"] %></p>
                <p class="small mb-2">
                  <% if aim["match"].present? %>
                    <span class="badge match-badge">Match</span> <%= aim["match"] %>
                  <% else %>
                    <span class="badge gap-badge">Gap</span> <span class="text-muted">Nothing you listed offers this yet</span>
                  <% end %>
                </p>
                <p class="small text-muted mb-1">Evidence to keep:</p>
                <ul class="small mb-0">
                  <% Array(aim["evidence_ideas"]).each do |idea| %>
                    <li><%= idea %></li>
                  <% end %>
                </ul>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if plan.gaps.any? %>
      <h2 class="h5 mb-2">Gaps: what nobody offers yet</h2>
      <p class="text-muted small">
        A gap is a to-do for your community, not a shortfall in your child. Someone nearby may be able to close it.
      </p>
      <ul class="mb-4">
        <% plan.gaps.each do |gap| %>
          <li class="mb-2">
            <strong><%= gap["name"] %></strong>
            <span class="text-muted small">(<%= Learner.area_label(gap["area"]) %>)</span><br>
            <span class="small"><%= gap["what_would_close_it"] %></span>
          </li>
        <% end %>
      </ul>
    <% end %>

    <div class="card mb-4 note-card">
      <div class="card-body">
        <h2 class="h6 mb-2">A note for you</h2>
        <p class="mb-0"><%= plan.note_to_guardian %></p>
      </div>
    </div>
  <% else %>
    <p class="text-muted fst-italic">This season is still being proposed&hellip;</p>
  <% end %>

  <div class="collapse mt-3" id="raw-response">
    <div class="card card-body">
      <p class="text-muted small mb-1">Raw response from Gemini:</p>
      <pre class="small mb-0 text-muted raw-response"><%= plan.gemini_raw %></pre>
    </div>
  </div>
</div>
